# Só para npm run dev:cloud: caminho absoluto da SUA chave de serviço, fora do repo. Nunca compartilhe.
GOOGLE_APPLICATION_CREDENTIALS=/caminho/absoluto/para/sua-chave.json

# Origens liberadas no CORS (separadas por vírgula). Padrão: http://localhost:8081. Ex.: web em rede local
CORS_ORIGINS=http://localhost:8081,http://192.168.0.10:8081
